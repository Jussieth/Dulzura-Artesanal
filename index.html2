<!DOCTYPE html> <html lang="es"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>Dulzura Artesanal</title> <style> /* ===== GENERAL ===== */ *{ box-sizing:border-box; margin:0; padding:0; } html{ scroll-behavior:smooth; } body{ font-family:Arial,sans-serif; background:#fff8f8; color:#542b32; } section{ padding:70px 18px; text-align:center; } h2{ color:#963e4e; font-size:32px; margin-bottom:15px; } .subtitulo{ max-width:700px; margin:0 auto 30px; line-height:1.7; color:#79535a; } /* ===== MENÚ ===== */ nav{ position:fixed; top:0; left:0; width:100%; background:#ffe0e5; padding:14px 5px; text-align:center; z-index:1000; box-shadow:0 3px 15px #c98b96; } nav a{ color:#8f3948; text-decoration:none; font-weight:bold; font-size:12px; margin:0 5px; } /* ===== INICIO ===== */ .inicio{ min-height:100vh; display:flex; justify-content:center; align-items:center; background:linear-gradient( 135deg, #ffdfe5, #fff5f1 ); padding-top:100px; } .inicio h1{ color:#963e4e; font-size:45px; margin-bottom:15px; } .inicio h2{ font-size:23px; color:#a94455; } .inicio p{ max-width:650px; margin:20px auto 30px; line-height:1.7; font-size:18px; } /* ===== BOTONES ===== */ .boton{ display:inline-block; border:none; background:#a94455; color:white; padding:14px 25px; border-radius:30px; text-decoration:none; font-weight:bold; cursor:pointer; margin:5px; } .boton:hover{ background:#873746; } /* ===== PRODUCTOS ===== */ .productos{ background:#fff4f1; } .productos-grid{ max-width:1000px; margin:auto; display:grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap:22px; } .producto{ background:white; padding:25px 18px; border-radius:22px; box-shadow: 0 5px 18px rgba(100,40,50,.12); } .producto .emoji{ font-size:55px; } .producto h3{ color:#963e4e; font-size:23px; margin:10px 0; } .producto p{ color:#806067; } .precio{ color:#a94455; font-size:24px; font-weight:bold; margin:12px; } .cantidad{ width:65px; padding:9px; text-align:center; border:2px solid #efc6cd; border-radius:10px; margin-bottom:10px; } .agregar{ display:block; width:100%; border:none; background:#f3c4cc; color:#74333e; padding:12px; border-radius:20px; font-weight:bold; cursor:pointer; } .agregar:active{ transform:scale(.97); } /* ===== CARRITO ===== */ .carrito{ background:#ffe9ec; } .caja-carrito{ max-width:700px; margin:auto; background:white; padding:25px; border-radius:25px; box-shadow: 0 5px 20px rgba(100,40,50,.12); } #listaCarrito{ margin-bottom:20px; } .item{ display:flex; justify-content:space-between; align-items:center; padding:14px 5px; border-bottom: 1px solid #f0d5da; text-align:left; } .eliminar{ border:none; background:#f5c5cc; color:#7d3441; padding:7px 10px; border-radius:10px; cursor:pointer; } .vacio{ color:#8c6c72; padding:20px; } .total{ color:#963e4e; font-size:28px; font-weight:bold; margin:25px 0; } /* ===== PRESENTACIÓN ===== */ .presentacion{ background:#fff8f8; } .presentacion-box{ max-width:800px; margin:auto; display:flex; align-items:center; justify-content:center; gap:35px; background:white; padding:30px; border-radius:25px; box-shadow: 0 5px 20px rgba(100,40,50,.12); } .presentacion-box img{ width:250px; height:250px; object-fit:cover; border-radius:20px; } .presentacion-text{ text-align:left; line-height:1.8; } .presentacion-text h3{ color:#963e4e; font-size:27px; margin-bottom:15px; } /* ===== HORARIO ===== */ .horario{ background:#ffe9ec; } .horario-box{ max-width:550px; margin:auto; background:white; padding:30px; border-radius:25px; box-shadow: 0 5px 20px rgba(100,40,50,.12); } .reloj{ font-size:55px; } .horario-box h3{ color:#963e4e; font-size:25px; margin:10px; } .hora{ color:#a94455; font-size:24px; font-weight:bold; } /* ===== PROCESO ===== */ .proceso{ background:#fff8f8; } .pasos{ max-width:950px; margin:auto; display:flex; justify-content:center; flex-wrap:wrap; gap:20px; } .paso{ width:270px; background:white; padding:25px; border-radius:20px; .img-proceso{
    width:100%;
    height:180px;
    object-fit:cover;
    border-radius:15px;
    margin-bottom:15px;
} box-shadow: 0 5px 18px rgba(100,40,50,.1); } .numero{ width:45px; height:45px; margin:auto auto 12px; border-radius:50%; display:flex; justify-content:center; align-items:center; background:#ffdce2; color:#963e4e; font-weight:bold; font-size:20px; } .paso h3{ color:#963e4e; margin-bottom:10px; } .paso p{ line-height:1.6; } /* ===== MERCADO ===== */ .mercado{ background:#fff0f2; } .mercado button{ border:none; background:#ffdce2; color:#8f3948; padding:12px 18px; border-radius:25px; margin:5px; cursor:pointer; font-weight:bold; } .mercado button:hover{ background:#a94455; color:white; } .mercado-info{ max-width:650px; min-height:150px; margin:25px auto 0; background:white; padding:30px; border-radius:25px; } .mercado-info h3{ color:#963e4e; margin-bottom:15px; } .mercado-info p{ line-height:1.7; } /* ===== NOSOTROS ===== */ .nosotros{ background:linear-gradient( 135deg, #fff4f1, #ffe4e9 ); } .nosotros-box{ max-width:800px; margin:auto; background:white; padding:35px; border-radius:25px; line-height:1.8; box-shadow: 0 5px 20px rgba(100,40,50,.12); } .nosotros-box h3{ color:#963e4e; font-size:27px; margin-bottom:15px; } .nosotros-box p{ margin-bottom:15px; } /* ===== CIERRE ===== */ .cierre{ background:#963e4e; color:white; } .cierre h2{ color:white; } .cierre p{ max-width:700px; margin:auto; line-height:1.8; } /* ===== WHATSAPP ===== */ .whatsapp{ position:fixed; right:18px; bottom:18px; width:60px; height:60px; border-radius:50%; background:#25D366; color:white; display:flex; justify-content:center; align-items:center; text-decoration:none; font-size:30px; z-index:2000; box-shadow: 0 5px 15px rgba(0,0,0,.2); } /* ===== FOOTER ===== */ footer{ background:#7d3441; color:white; text-align:center; padding:30px; line-height:1.8; } /* ===== CELULAR ===== */ @media(max-width:700px){ .inicio h1{ font-size:37px; } nav a{ font-size:10px; margin:0 2px; } .presentacion-box{ flex-direction:column; } .presentacion-text{ text-align:center; } .presentacion-box img{ width:220px; height:220px; } } </style> </head> <body> <!-- ===================== MENÚ ===================== --> <nav> <a href="#inicio">Inicio</a> <a href="#productos">Sabores</a> <a href="#carrito">Compra</a> <a href="#presentacion">Producto</a> <a href="#horario">Horario</a> <a href="#proceso">Proceso</a> <a href="#mercado">Mercado</a> <a href="#nosotros">Nosotros</a> </nav> <!-- ===================== INICIO ===================== --> <section class="inicio" id="inicio" > <div> <div class="logo-dulzura">

